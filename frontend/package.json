{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "rulebook:manifest": "node tools/generate-rulebook-manifest.mjs",
    "map:atlas": "node tools/generate-map-atlas.mjs",
    "prestart": "npm run rulebook:manifest && npm run map:atlas",
    "start": "ng serve",
    "prebuild": "npm run rulebook:manifest && npm run map:atlas",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@nestjs/platform-express": "^11.1.9",
    "markdown-it": "^15.0.0",
    "markdown-it-container": "^4.0.0",
    "multer": "^2.0.2",
    "openseadragon": "^6.0.2",
    "pixi.js": "^8.19.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "@types/multer": "^2.0.0",
    "@types/openseadragon": "^5.0.2",
    "jsdom": "^27.1.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
